VITE_WP_REST_BASE_URL=https://admin.revistachiveve.com/wp-json/wp/v2
VITE_SITE_URL=https://www.revistachiveve.com
SITE_URL=https://www.revistachiveve.com

# Server-only (do not prefix with VITE)
# Use these when WordPress REST requires authentication.
WP_REST_BASE_URL=https://admin.revistachiveve.com/wp-json/wp/v2
WP_APP_USERNAME=your-wordpress-username
WP_APP_PASSWORD=your-wordpress-application-password

# Public directory/tender submissions (dedicated Contributor account)
WP_SUBMISSION_USERNAME=website-submissions
WP_SUBMISSION_PASSWORD=your-dedicated-application-password

# Cloudflare Turnstile for public submission forms
TURNSTILE_SECRET=your-turnstile-secret
TURNSTILE_HOSTNAMES=www.revistachiveve.com
SUBMISSION_ORIGINS=https://www.revistachiveve.com

# Contact form email delivery through Resend (server-only)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Revista Chiveve <contacto@news.revistachiveve.com>"
CONTACT_TO_EMAIL=revistachivevemoz@gmail.com
